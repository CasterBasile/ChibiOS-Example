/ {
    chosen {
        /* display usato di default dall'app */
        zephyr,display = &ssd1306;
    };
};

/* I2C1: PB8 = SCL, PB9 = SDA sulla Nucleo-G474RE */
&i2c1 {
    status = "okay";

    ssd1306: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        status = "okay";

        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};

